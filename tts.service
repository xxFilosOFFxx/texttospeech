[Unit]
Description=Text to Speech Converter Telegram Bot
After=network.target

[Service]
Type=simple
User=sergey
WorkingDirectory=/home/sergey/projects/texttospeech
ExecStart=/usr/bin/python3 /home/sergey/projects/texttospeech/bot.py YOUR_BOT_TOKEN
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/sergey/projects/texttospeech/bot.log
StandardError=append:/home/sergey/projects/texttospeech/bot.log

[Install]
WantedBy=multi-user.target